# ─── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret

# URL where this app is deployed (no trailing slash)
# Local dev:
NEXTAUTH_URL=http://localhost:3000
# Production:
# NEXTAUTH_URL=https://portal.citiuscloud.in


# ─── AWS Cognito ───────────────────────────────────────────────────────────────
# Create a User Pool and App Client in Cognito, then fill these in.

# App Client ID (not secret)
COGNITO_CLIENT_ID=your-cognito-app-client-id

# App Client Secret
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret

# Issuer URL — format: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_XXXXXXXXX


# ─── AWS SDK ───────────────────────────────────────────────────────────────────
# On EC2 with an instance profile, you do NOT need these — credentials come from
# the instance role automatically. Only set these for local development.

AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key      # Local dev only
# AWS_SECRET_ACCESS_KEY=your-secret-key  # Local dev only


# ─── DynamoDB Table Names ──────────────────────────────────────────────────────
CUSTOMERS_TABLE=citius-customers
AUDIT_TABLE=citius-audit-logs
